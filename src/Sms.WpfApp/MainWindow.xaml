<Window x:Class="Sms.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Sms.WpfApp.Controls"
        Title="Тестовое WPF-приложение для SmartMealService"
        Width="920"
        Height="560"
        MinWidth="680"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="24">
        <Border Background="#FFFDFD"
                CornerRadius="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="28,14,20,8"
                      MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#323232"
                               Text="Тестовое WPF-приложение для SmartMealService" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource WindowButtonStyle}"
                                ToolTip="Свернуть"
                                Click="MinimizeButton_OnClick"
                                Content="&#x2014;" />
                        <Button Style="{StaticResource WindowButtonStyle}"
                                ToolTip="Закрыть"
                                Click="CloseButton_OnClick"
                                Content="&#x2715;" />
                    </StackPanel>
                </Grid>

                <controls:RoundedClipBorder Grid.Row="1"
                                            Margin="28,0,28,28"
                                            Background="White"
                                            BorderBrush="#3D3D3D"
                                            BorderThickness="2"
                                            CornerRadius="24">
                    <DataGrid ItemsSource="{Binding Variables}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FCFDF7"
                              RowHeaderWidth="0"
                              SelectionUnit="CellOrRowHeader">
                        <DataGrid.Columns>
                            <DataGridTextColumn 
                                                Width="0.2*"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Поле"
                                                Width="1.1*"
                                                IsReadOnly="True"
                                                Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Значение"
                                                Width="1.4*"
                                                Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <DataGridTextColumn Header="Комментарий"
                                                Width="1.6*"
                                                IsReadOnly="True"
                                                HeaderStyle="{StaticResource LastColumnHeaderStyle}"
                                                CellStyle="{StaticResource LastColumnCellStyle}"
                                                Binding="{Binding Comment}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:RoundedClipBorder>
            </Grid>
        </Border>
    </Grid>
</Window>
